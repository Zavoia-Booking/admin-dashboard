# Loaded by Vite when running `yarn dev --mode test` (used by Playwright's webServer).
# Points the dev server's /api proxy at the test admin-api on port 3001.
VITE_API_PROXY_TARGET=http://localhost:3001
# Sign in with Apple (web). Any values work in tests: e2e/fixtures/apple-mocks.ts
# replaces Apple JS and the API. Real values: staging com.zavoia.signin.web.staging
# + https://staging-app.zavoia.com/auth/apple/callback, prod com.zavoia.signin.web
# + https://app.zavoia.com/auth/apple/callback (set them in Vercel).
VITE_APPLE_SERVICES_ID=com.zavoia.signin.web.test
VITE_APPLE_REDIRECT_URI=http://localhost:5174/auth/apple/callback
